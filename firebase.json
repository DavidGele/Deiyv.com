{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "Dockerfile", "cloudbuild.yaml", "nginx.conf", "README.md"],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|js|css)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
      }
    ],
    "cleanUrls": false
  }
}
